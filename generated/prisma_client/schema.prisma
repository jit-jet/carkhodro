// ─────────────────────────────────────────────────────────────────────────────
// Carkhodro — Auto Spare Parts E-Commerce
// PostgreSQL · Prisma ORM
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma_client"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  RETAIL
  WHOLESALE
  ADMIN // full back-office access
  SUPPORT // read-only order/customer access
}

/// Audience filter for a bulk SMS blast — mirrors the RETAIL/WHOLESALE split
/// used everywhere else for pricing, with ALL meaning both.
enum SmsTargetRole {
  RETAIL
  WHOLESALE
  ALL
}

enum SmsCampaignStatus {
  PENDING
  SENT
  PARTIAL // some recipients failed
  FAILED
}

enum AdminActivityStatus {
  SUCCESS
  FAILURE
  BLOCKED
}

/// Wholesale-order lifecycle, surfaced in the partner dashboard's order list and
/// status filter. Ordered roughly by progression; cancellation/archive are
/// terminal side-states. Persian labels live in `src/lib/order-labels.ts`.
enum OrderStatus {
  NEW // سفارش جدید — just submitted
  AWAITING_CONFIRMATION // در انتظار تایید — pending shop review
  CONFIRMED_AWAITING_PAYMENT // تایید شده و در انتظار پرداخت
  PAID // پرداخت شده توسط مشتری
  SHIPPED // ارسال سفارش — handed to carrier
  COMPLETED // اتمام فاکتور — invoice closed
  CANCELLED_BY_CUSTOMER // لغو شده توسط مشتری
  CANCELLED_BY_MANAGER // لغو توسط مدیرفروشگاه
  ARCHIVED // آرشیو
}

/// Direction of a support message relative to the partner (who owns the thread).
enum MessageDirection {
  INBOUND // received by the partner (sent by the support desk)
  OUTBOUND // sent by the partner to support
}

enum PaymentMethod {
  ONLINE // IPG redirect
  COD // cash on delivery
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

/// How a redeemable coupon reduces the order total.
enum DiscountType {
  PERCENTAGE // درصدی — value is 0–100
  FIXED_AMOUNT // مبلغی — value is Toman
  FREE_SHIPPING // ارسال رایگان — value ignored
}

/// What catalogue slice a discount code applies to.
/// ALL ignores `scopeIds`. For other types, empty `scopeIds` also means all products.
enum DiscountScopeType {
  ALL // همه محصولات — scopeIds ignored / stored empty
  CATEGORY // دسته‌بندی — scopeIds are Category.id as strings
  BRAND // برند قطعه — scopeIds are PartsBrand.id as strings
  CAR_BRAND // برند خودرو — scopeIds are CarBrand.id as strings
  CAR_MODEL // مدل خودرو — scopeIds are CarModel.id as strings
  PRODUCT // محصول — scopeIds are Product.id (cuid)
}

/// Which storefront audience may redeem a discount code.
/// BOTH = retail customers and wholesale partners.
enum DiscountTargetUserType {
  RETAIL
  WHOLESALE
  BOTH
}

/// Which footer column a managed link belongs to.
enum FooterLinkGroup {
  QUICK // لینک‌های سریع
  CATEGORY // دسته‌بندی‌ها
}

// ─────────────────────────────────────────────────────────────────────────────
// REFERENCE DATA
// ─────────────────────────────────────────────────────────────────────────────

/// The 31 Iranian provinces — seeded once; never deleted.
model Province {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  cities City[]

  @@map("provinces")
}

/// Cities nested under a province — seeded from a standard list; admin can add more.
model City {
  id         Int      @id @default(autoincrement())
  provinceId Int      @map("province_id")
  name       String
  createdAt  DateTime @default(now()) @map("created_at")

  province  Province  @relation(fields: [provinceId], references: [id])
  addresses Address[]

  @@unique([provinceId, name])
  @@index([provinceId])
  @@map("cities")
}

/// Top-level navigation links — managed by admin; front end caches and revalidates.
model NavLink {
  id        Int      @id @default(autoincrement())
  href      String   @unique
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("nav_links")
}

/// Footer column links — «لینک‌های سریع» / «دسته‌بندی‌ها», managed in admin.
model FooterLink {
  id        Int             @id @default(autoincrement())
  group     FooterLinkGroup
  href      String
  label     String
  sortOrder Int             @default(0) @map("sort_order")
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@index([group, sortOrder])
  @@map("footer_links")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTHENTICATION
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                       String    @id @default(cuid())
  /// Iranian mobile format: 09XXXXXXXXX (11 digits)
  phoneNumber              String    @unique @map("phone_number")
  firstName                String    @map("first_name")
  lastName                 String    @map("last_name")
  role                     UserRole  @default(RETAIL)
  /// Set to true after the first successful OTP verification
  isVerified               Boolean   @default(false) @map("is_verified")
  /// When false, the user cannot log in (storefront OTP or admin password).
  isActive                 Boolean   @default(true) @map("is_active")
  /// Wholesale customers must supply a shop/business name
  shopName                 String?   @map("shop_name")
  birthDate                DateTime? @map("birth_date")
  profileImage             String?   @map("profile_image")
  /// Partner's running ledger balance with the shop, in the same magnitude as
  /// product prices (Toman). Shown as «مانده حساب» on the dashboard.
  accountBalance           BigInt    @default(0) @map("account_balance")
  /// Who referred this partner («معرف») — free text captured on the profile.
  referredBy               String?   @map("referred_by")
  /// The partner's line of business («زمینه فعالیت») — free text.
  activityField            String?   @map("activity_field")
  /// Short, unique partner/affiliate code («کد اختصاصی») — null for retail users.
  partnerCode              String?   @unique @map("partner_code")
  /// Admin login username — only set for ADMIN-role users; storefront customers
  /// authenticate with SMS OTP and never get one.
  username                 String?   @unique
  /// Scrypt password hash — only set for admin/back-office logins (ADMIN role).
  /// Storefront customers keep authenticating with SMS OTP and never get one.
  passwordHash             String?   @map("password_hash")
  /// Grants access to security-sensitive system configuration. This is kept
  /// separate from ADMIN so future back-office accounts are least-privileged.
  isSuperAdmin             Boolean   @default(false) @map("is_super_admin")
  /// Consecutive failed password attempts for the admin login only.
  failedAdminLoginAttempts Int       @default(0) @map("failed_admin_login_attempts")
  /// Admin password login is rejected until this timestamp. Storefront OTP
  /// authentication is intentionally unaffected.
  adminLockedUntil         DateTime? @map("admin_locked_until")
  /// Hesabfa contact `Code` — unique link key for two-way contact sync.
  hesabfaCode              String?   @unique @map("hesabfa_code")
  /// Hesabfa internal numeric contact Id (webhook ObjectIdList).
  hesabfaId                Int?      @unique @map("hesabfa_id")
  /// Last successful Hesabfa contact sync timestamp.
  hesabfaSyncedAt          DateTime? @map("hesabfa_synced_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  addresses          Address[]
  sessions           Session[]
  orders             Order[]
  reviews            Review[]
  cart               Cart?
  wishlist           WishlistItem[]
  compareItems       CompareItem[]
  supportMessages    SupportMessage[]
  orderSurveys       OrderSurvey[]
  priceListRequests  PriceListRequest[]
  productSuggestions ProductSuggestion[]
  smsCampaigns       SmsCampaign[]
  adminActivityLogs  AdminActivityLog[]

  @@index([phoneNumber])
  @@index([isActive])
  @@index([hesabfaCode])
  @@map("users")
}

/// One active OTP per phone number — upserted on every send request.
model OtpSession {
  id          String   @id @default(cuid())
  phoneNumber String   @unique @map("phone_number")
  /// Bcrypt-hashed in production; store plain only in dev/test
  codeHash    String   @map("code_hash")
  /// Hard cutoff — reject even if code matches after this time
  expiresAt   DateTime @map("expires_at")
  /// Count repeated send attempts to enable rate-limiting
  attempts    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([phoneNumber])
  @@map("otp_sessions")
}

/// Server-issued session token — created after OTP is consumed.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// User delivery addresses — one user may save many; at most one isDefault.
model Address {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  cityId     Int      @map("city_id")
  street     String
  postalCode String   @map("postal_code")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  city   City    @relation(fields: [cityId], references: [id])
  orders Order[]

  @@index([userId])
  @@index([cityId])
  @@map("addresses")
}

// ─────────────────────────────────────────────────────────────────────────────
// CATALOGUE — CAR TAXONOMY
// ─────────────────────────────────────────────────────────────────────────────

/// Automobile manufacturers / vehicle brands (“برند خودرو”): ایران‌خودرو, سایپا, تویوتا, …
model CarBrand {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  /// URL-safe slug, e.g. "iran-khodro"
  slug         String   @unique
  logoImage    String?  @map("logo_image")
  /// Denormalized counter — refreshed by a background job or DB trigger
  productCount Int      @default(0) @map("product_count")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  carModels CarModel[]

  @@index([isActive])
  @@map("car_brands")
}

/// Specific vehicle models (“مدل خودرو”) — FK carBrandId → car_brands.id
model CarModel {
  id              Int      @id @default(autoincrement())
  carBrandId      Int      @map("car_brand_id")
  name            String
  image           String?
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description") @db.Text
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  carBrand        CarBrand               @relation(fields: [carBrandId], references: [id])
  compatibilities ProductCompatibility[]

  @@index([carBrandId])
  @@index([isActive])
  @@map("car_models")
}

// ─────────────────────────────────────────────────────────────────────────────
// CATALOGUE — PARTS
// ─────────────────────────────────────────────────────────────────────────────

/// Spare-parts suppliers / manufacturers: بوش, NGK, ایساکو, …
/// Distinct from CarBrand — a Bosch brake pad fits a Toyota, not made by Toyota.
model PartsBrand {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  /// URL / filter slug, e.g. "bosch", "ngk"
  slug            String   @unique
  logoImage       String?  @map("logo_image")
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description") @db.Text
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([isActive])
  @@map("parts_brands")
}

/// Product category: موتور و قطعات, ترمز و تعلیق, برق و روشنایی, …
model Category {
  id              Int      @id @default(autoincrement())
  /// URL / filter slug, e.g. "engine", "brake"
  key             String   @unique
  name            String
  image           String   @default("/logo.png")
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description") @db.Text
  sortOrder       Int      @default(0) @map("sort_order")
  /// Denormalized counter — refreshed by a background job or DB trigger
  productCount    Int      @default(0) @map("product_count")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([isActive])
  @@map("categories")
}

// ─────────────────────────────────────────────────────────────────────────────
// PRODUCT
// ─────────────────────────────────────────────────────────────────────────────

model Product {
  id           String @id @default(cuid())
  /// Human-readable part number, e.g. "BSH-ENG-206-001"
  sku          String @unique
  name         String
  partsBrandId Int    @map("parts_brand_id")
  categoryId   Int    @map("category_id")

  // ── Pricing ────────────────────────────────────────────────────────────────
  /// Base wholesale price in Toman.
  wholesalePrice        BigInt  @map("wholesale_price")
  /// Optional purchase / cost price in Toman (Hesabfa `BuyPrice`).
  buyPrice              BigInt? @map("buy_price")
  /// Percentage deducted for WHOLESALE users (0–100).
  /// wholesaleFinal = wholesalePrice × (1 − wholesaleDiscountPct / 100)
  wholesaleDiscountPct  Decimal @default(0) @map("wholesale_discount_pct") @db.Decimal(5, 2)
  /// Percentage added to wholesalePrice to derive the retail list price (1–100).
  /// retailPrice = wholesalePrice × (1 + retailPriceDiffPct / 100)
  retailPriceDiffPct    Decimal @default(25) @map("retail_price_diff_pct") @db.Decimal(5, 2)
  /// Percentage deducted from retailPrice for RETAIL users (0–100).
  /// retailFinal = retailPrice × (1 − retailDiscountPct / 100)
  retailDiscountPct     Decimal @default(0) @map("retail_discount_pct") @db.Decimal(5, 2)
  isOffer               Boolean @default(false) @map("is_offer")
  /// When true, retail/guest users see “Call for Price” instead of the price and cannot purchase.
  callForPriceRetail    Boolean @default(false) @map("call_for_price_retail")
  /// When true, wholesale partners see “Call for Price” instead of the price and cannot purchase.
  callForPriceWholesale Boolean @default(false) @map("call_for_price_wholesale")

  // ── Hesabfa accounting link ───────────────────────────────────────────────
  /// Hesabfa item `Code` — unique link key for two-way product sync.
  hesabfaCode  String?   @unique @map("hesabfa_code")
  /// Hesabfa internal numeric item Id (webhook ObjectIdList / deletes).
  hesabfaId    Int?      @unique @map("hesabfa_id")
  /// Timestamp of the last successful Hesabfa product sync.
  lastSyncedAt DateTime? @map("last_synced_at")

  // ── Inventory ─────────────────────────────────────────────────────────────
  stock Int @default(0)

  // ── Physical / logistics details (managed by local admin) ─────────────────
  /// Country of origin, e.g. "آلمان", "ژاپن", "ایران"
  origin         String?
  /// Units per retail pack (e.g. spark plugs come in sets of 4)
  packQuantity   Int     @default(1) @map("pack_quantity")
  /// Retail packs per master carton — for wholesale order sizing
  cartonQuantity Int     @default(1) @map("carton_quantity")
  /// Display unit label on the storefront (e.g. "عدد", "بسته", "متر")
  unit           String  @default("عدد")
  /// true = OEM / genuine part; false = aftermarket
  isOriginal     Boolean @default(true) @map("is_original")

  // ── Content (managed by local admin) ──────────────────────────────────────
  mainImage       String? @map("main_image")
  description     String? @db.Text
  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description") @db.Text
  imageAlt        String? @map("image_alt")

  // ── Fuzzy full-text search ────────────────────────────────────────────────
  /// Denormalized, normalized search document (name + sku + origin + parts-brand
  /// + category + compatible car models). DB-maintained via triggers — never
  /// written from application code. Queried with pg_trgm for typo-tolerant search.
  searchText String? @map("search_text")

  // ── Analytics ──────────────────────────────────────────────────────────────
  viewCount   Int     @default(0) @map("view_count")
  saleCount   Int     @default(0) @map("sale_count")
  /// Denormalized average star rating (1.00–5.00) — recomputed on each new review
  ratingAvg   Decimal @default(0) @map("rating_avg") @db.Decimal(3, 2)
  reviewCount Int     @default(0) @map("review_count")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  partsBrand      PartsBrand             @relation(fields: [partsBrandId], references: [id])
  category        Category               @relation(fields: [categoryId], references: [id])
  images          ProductImage[]
  compatibilities ProductCompatibility[]
  reviews         Review[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  wishlistedBy    WishlistItem[]
  comparedBy      CompareItem[]

  @@index([sku])
  @@index([hesabfaCode])
  @@index([categoryId])
  @@index([partsBrandId])
  @@index([isActive, isOffer])
  @@index([saleCount])
  @@index([viewCount])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_search_text_trgm_idx")
  @@map("products")
}

/// Additional product gallery images (beyond mainImage).
model ProductImage {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  url       String
  alt       String?
  sortOrder Int     @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

/// Many-to-many: a spare part can be compatible with multiple car models.
model ProductCompatibility {
  id         String @id @default(cuid())
  productId  String @map("product_id")
  carModelId Int    @map("car_model_id")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  carModel CarModel @relation(fields: [carModelId], references: [id], onDelete: Cascade)

  @@unique([productId, carModelId])
  @@index([productId])
  @@index([carModelId])
  @@map("product_compatibilities")
}

/// Customer review and star rating on a product.
model Review {
  id                 String    @id @default(cuid())
  productId          String    @map("product_id")
  /// Nullable — preserves display name even if the user account is deleted
  userId             String?   @map("user_id")
  authorName         String    @map("author_name")
  /// 1–5
  rating             Int
  text               String    @db.Text
  /// true only when the author has a completed order containing this product
  isVerifiedPurchase Boolean   @default(false) @map("is_verified_purchase")
  /// Admin-side read flag for the communications inbox (defaults unread for new reviews).
  isRead             Boolean   @default(false) @map("is_read")
  /// When true, the review is hidden from the storefront but kept in the admin inbox.
  isHidden           Boolean   @default(false) @map("is_hidden")
  /// Optional public reply from the shop, shown under the review on the PDP.
  adminReply         String?   @map("admin_reply") @db.Text
  repliedAt          DateTime? @map("replied_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([userId])
  @@index([isRead])
  @@index([isHidden])
  @@map("reviews")
}

// ─────────────────────────────────────────────────────────────────────────────
// CART
// ─────────────────────────────────────────────────────────────────────────────

/// One active cart per user — created lazily on first add-to-cart action.
model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String   @map("cart_id")
  productId String   @map("product_id")
  quantity  Int      @default(1)
  addedAt   DateTime @default(now()) @map("added_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// WISHLIST & COMPARE
// ─────────────────────────────────────────────────────────────────────────────

/// A product a user has saved for later. Independent of the cart — purely a
/// per-user bookmark. One row per (user, product); re-adding is a no-op.
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("wishlist_items")
}

/// A product a user has added to their side-by-side compare list. Same shape as
/// the wishlist but a separate concern; the app caps the active list size.
model CompareItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("compare_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// FAQ
// ─────────────────────────────────────────────────────────────────────────────

/// Blog post categories — admin-managed taxonomy for /blog filtering.
model PostCategory {
  id              Int      @id @default(autoincrement())
  /// URL-safe slug, e.g. "maintenance"
  slug            String   @unique
  name            String
  description     String?  @db.Text
  /// Optional SEO overrides for category listing pages.
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description") @db.Text
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  posts Post[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("post_categories")
}

/// Blog posts — authored by admin; displayed on /blog and /blog/[slug].
model Post {
  id          Int      @id @default(autoincrement())
  /// URL-safe slug, e.g. "oil-change-guide"
  slug        String   @unique
  title       String
  excerpt     String   @db.Text
  /// HTML body — admin-authored content, never direct user input.
  body        String   @db.Text
  coverImage  String   @map("cover_image")
  author      String
  tags        String[]
  /// Estimated read time in minutes
  readTime    Int      @map("read_time")
  publishedAt DateTime @map("published_at")
  isPublished Boolean  @default(true) @map("is_published")
  categoryId  Int?     @map("category_id")

  // ── SEO / Open Graph ───────────────────────────────────────────────────────
  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description") @db.Text
  metaKeywords    String? @map("meta_keywords")
  ogTitle         String? @map("og_title")
  ogDescription   String? @map("og_description") @db.Text
  /// Falls back to coverImage when null.
  ogImage         String? @map("og_image")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category PostCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([publishedAt])
  @@index([isPublished])
  @@index([categoryId])
  @@map("posts")
}

/// Frequently-asked questions — admin-managed; displayed on the /faq page.
model Faq {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String   @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("faqs")
}

// ─────────────────────────────────────────────────────────────────────────────
// SITE SETTINGS — singleton row, admin-managed
// ─────────────────────────────────────────────────────────────────────────────

/// Dynamic site info shown across the storefront (footer/contact/etc). Always a
/// single row — the app upserts `id = 1`.
model SiteSetting {
  id                        Int      @id @default(1)
  /// Shown to guests and RETAIL customers.
  retailPhone1              String?  @map("retail_phone_1")
  retailPhone2              String?  @map("retail_phone_2")
  /// Shown only when a WHOLESALE user is logged in.
  wholesalePhone1           String?  @map("wholesale_phone_1")
  wholesalePhone2           String?  @map("wholesale_phone_2")
  wholesalePhone3           String?  @map("wholesale_phone_3")
  wholesalePhone4           String?  @map("wholesale_phone_4")
  email                     String?
  address                   String?  @db.Text
  workingHours              String?  @map("working_hours")
  /// Short promo lines shown in the header top bar (e.g. trust badges).
  headerPromo1              String?  @map("header_promo_1")
  headerPromo2              String?  @map("header_promo_2")
  /// Optional icon for promo line 1 — storage URL or emoji; no built-in default.
  headerPromo1Icon          String?  @map("header_promo_1_icon")
  /// Optional icon for promo line 2 — storage URL or emoji; no built-in default.
  headerPromo2Icon          String?  @map("header_promo_2_icon")
  aboutText                 String?  @map("about_text") @db.Text
  /// Footer trust badges (icon / title / description) — four fixed slots.
  footerTrust1Icon          String?  @map("footer_trust_1_icon")
  footerTrust1Title         String?  @map("footer_trust_1_title")
  footerTrust1Desc          String?  @map("footer_trust_1_desc")
  footerTrust2Icon          String?  @map("footer_trust_2_icon")
  footerTrust2Title         String?  @map("footer_trust_2_title")
  footerTrust2Desc          String?  @map("footer_trust_2_desc")
  footerTrust3Icon          String?  @map("footer_trust_3_icon")
  footerTrust3Title         String?  @map("footer_trust_3_title")
  footerTrust3Desc          String?  @map("footer_trust_3_desc")
  footerTrust4Icon          String?  @map("footer_trust_4_icon")
  footerTrust4Title         String?  @map("footer_trust_4_title")
  footerTrust4Desc          String?  @map("footer_trust_4_desc")
  /// Homepage hero copy (static — images are managed via HeroBanner slides).
  heroTitle                 String?  @map("hero_title")
  heroDescription           String?  @map("hero_description") @db.Text
  heroButton1Text           String?  @map("hero_button1_text")
  heroButton1Href           String?  @map("hero_button1_href")
  heroButton2Text           String?  @map("hero_button2_text")
  heroButton2Href           String?  @map("hero_button2_href")
  /// Branding, default SEO, and analytics (admin-managed).
  siteName                  String?  @map("site_name")
  logoUrl                   String?  @map("logo_url")
  productWatermarkUrl       String?  @map("product_watermark_url")
  productWatermarkPosition  String   @default("bottom-right") @map("product_watermark_position")
  faviconUrl                String?  @map("favicon_url")
  appleTouchIconUrl         String?  @map("apple_touch_icon_url")
  metaTitle                 String?  @map("meta_title")
  metaDescription           String?  @map("meta_description") @db.Text
  ogImageUrl                String?  @map("og_image_url")
  copyrightText             String?  @map("copyright_text")
  /// Google Analytics (`G-…` / `UA-…`) or Google Tag Manager (`GTM-…`) container ID.
  analyticsId               String?  @map("analytics_id")
  googleAnalyticsId         String?  @map("google_analytics_id")
  googleTagManagerId        String?  @map("google_tag_manager_id")
  searchConsoleVerification String?  @map("search_console_verification")
  robotsIndex               Boolean  @default(true) @map("robots_index")
  robotsFollow              Boolean  @default(true) @map("robots_follow")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model SeoRedirect {
  id          Int      @id @default(autoincrement())
  source      String   @unique
  destination String
  statusCode  Int      @default(301) @map("status_code")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("seo_redirects")
}

model StaticPageSeo {
  path            String   @id
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description") @db.Text
  ogImageUrl      String?  @map("og_image_url")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("static_page_seo")
}

/// Append-only security/activity audit trail for admin authentication and
/// important back-office mutations. Inputs and secrets are never stored.
model AdminActivityLog {
  id            String              @id @default(cuid())
  actorId       String?             @map("actor_id")
  actorUsername String?             @map("actor_username")
  action        String
  status        AdminActivityStatus
  ipAddress     String?             @map("ip_address")
  userAgent     String?             @map("user_agent")
  metadata      Json?
  createdAt     DateTime            @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([status, createdAt])
  @@map("admin_activity_logs")
}

/// Encrypted integration configuration. The application only ever decrypts
/// this singleton inside its server-only settings DAL.
model SystemSetting {
  id              Int      @id @default(1)
  encryptedConfig String   @map("encrypted_config") @db.Text
  updatedById     String?  @map("updated_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

/// Terms & rules page content — singleton row (`id = 1`), admin-edited via TipTap.
model RulesContent {
  id           Int      @id @default(1)
  /// Line under the page title (e.g. last-updated note).
  updatedLabel String?  @map("updated_label")
  /// Amber intro banner text on /rules.
  intro        String?  @db.Text
  /// Main rules body HTML — admin-authored via TipTap.
  body         String   @default("") @db.Text
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("rules_content")
}

/// Product return policy page content — singleton row (`id = 1`), admin-edited via TipTap.
model ReturnContent {
  id        Int      @id @default(1)
  body      String   @default("") @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("return_content")
}

/// Admin-managed social media links — shown in the footer and contact page.
model SocialLink {
  id        Int      @id @default(autoincrement())
  label     String
  url       String
  /// Display icon — typically an emoji (e.g. 📸 for Instagram).
  icon      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("social_links")
}

/// Homepage hero image slides — copy/CTAs live on SiteSetting; only images rotate.
model HeroBanner {
  id        Int      @id @default(autoincrement())
  imageUrl  String   @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("hero_banners")
}

// ─────────────────────────────────────────────────────────────────────────────
// BULK SMS MARKETING — admin-managed
// ─────────────────────────────────────────────────────────────────────────────

/// One row per bulk SMS blast the admin sends («ارسال گروهی پیامک»). Snapshot
/// only — the recipient list itself isn't retained, just the counts, to keep
/// this table cheap and avoid storing phone numbers redundantly.
model SmsCampaign {
  id             String            @id @default(cuid())
  body           String            @db.Text
  targetRole     SmsTargetRole     @map("target_role")
  recipientCount Int               @default(0) @map("recipient_count")
  successCount   Int               @default(0) @map("success_count")
  failedCount    Int               @default(0) @map("failed_count")
  status         SmsCampaignStatus @default(PENDING)
  createdById    String?           @map("created_by_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  completedAt    DateTime?         @map("completed_at")

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("sms_campaigns")
}

// ─────────────────────────────────────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────────────────────────────────────

/// Shipping methods and their current cost — editable by admin.
/// `method` is a stable unique code (e.g. STANDARD, EXPRESS); free-form codes allowed.
model ShippingOption {
  id          String   @id @default(cuid())
  method      String   @unique
  label       String
  description String?
  cost        BigInt
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@map("shipping_options")
}

model Order {
  id               String        @id @default(cuid())
  /// Human-facing, sequential invoice number («شماره فاکتور») shown on the
  /// partner's orders list and printable invoice — distinct from the cuid `id`.
  orderNumber      Int           @unique @default(autoincrement()) @map("order_number")
  userId           String        @map("user_id")
  /// FK kept for history; address data also snapshotted below.
  addressId        String        @map("address_id")
  shippingOptionId String        @map("shipping_option_id")
  status           OrderStatus   @default(NEW)
  paymentMethod    PaymentMethod @map("payment_method")
  paymentStatus    PaymentStatus @default(PENDING) @map("payment_status")
  /// Free-text settlement terms chosen on the partner invoice (e.g. «چکی», «نقدی»,
  /// «اعتباری»). Complements the coarse `paymentMethod` enum used by retail checkout.
  paymentTerms     String?       @map("payment_terms")

  // ── Snapshotted delivery address ──────────────────────────────────────────
  // Copied at checkout so later edits to the address row don't affect history.
  snapshotProvince   String @map("snapshot_province")
  snapshotCity       String @map("snapshot_city")
  snapshotStreet     String @map("snapshot_street")
  snapshotPostalCode String @map("snapshot_postal_code")

  // ── Financials ─────────────────────────────────────────────────────────────
  subtotal       BigInt  @map("subtotal")
  shippingCost   BigInt  @map("shipping_cost")
  /// VAT or other applicable tax collected on this order
  taxAmount      BigInt  @default(0) @map("tax_amount")
  /// Coupon discount applied at checkout (Toman). 0 when no code was used.
  discountAmount BigInt  @default(0) @map("discount_amount")
  /// Snapshot of the redeemed code string (kept even if the code row is deleted).
  discountCode   String? @map("discount_code")
  discountCodeId String? @map("discount_code_id")
  /// subtotal + shippingCost + taxAmount − discountAmount (stored to prevent drift)
  totalAmount    BigInt  @map("total_amount")

  notes        String?
  trackingCode String? @map("tracking_code")

  /// Zibal IPG session id — set when an online payment is initiated.
  paymentTrackId   BigInt? @map("payment_track_id")
  /// Bank reference number returned by Zibal after a successful verify.
  paymentRefNumber String? @map("payment_ref_number")

  /// Hesabfa sales invoice `Number` — unique link key (never import unknown invoices).
  hesabfaCode     String?   @unique @map("hesabfa_code")
  /// Hesabfa internal numeric invoice Id (webhook ObjectIdList).
  hesabfaId       Int?      @unique @map("hesabfa_id")
  /// Last successful Hesabfa invoice sync timestamp.
  hesabfaSyncedAt DateTime? @map("hesabfa_synced_at")

  paidAt      DateTime? @map("paid_at")
  shippedAt   DateTime? @map("shipped_at")
  deliveredAt DateTime? @map("delivered_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user           User           @relation(fields: [userId], references: [id])
  address        Address        @relation(fields: [addressId], references: [id])
  shippingOption ShippingOption @relation(fields: [shippingOptionId], references: [id])
  coupon         DiscountCode?  @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  survey         OrderSurvey?

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([discountCodeId])
  @@index([hesabfaCode])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String @map("order_id")
  productId String @map("product_id")

  // ── Immutable purchase snapshot ───────────────────────────────────────────
  productName     String  @map("product_name")
  productSku      String  @map("product_sku")
  /// Unit list price frozen at order time, before any line discount.
  priceAtPurchase BigInt  @map("price_at_purchase")
  /// Percentage discount applied to this line (0–100) — e.g. the wholesale /
  /// cash discount on a partner invoice. 0 for plain retail lines. The net unit
  /// price is priceAtPurchase × (1 − discountPct / 100).
  discountPct     Decimal @default(0) @map("discount_pct") @db.Decimal(5, 2)
  /// Tax portion of this line item (e.g. VAT on priceAtPurchase × quantity)
  taxAmount       BigInt  @default(0) @map("tax_amount")
  quantity        Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// PARTNER DASHBOARD
// ─────────────────────────────────────────────────────────────────────────────

/// Two-way support thread between a partner and the shop's support desk. A flat
/// message log (not threaded): the dashboard groups it into Inbox (INBOUND),
/// Sent (OUTBOUND) and Deleted (isDeleted) folders, with an unread badge on the
/// inbox. Soft-deleted messages move to the Deleted folder and can be restored.
model SupportMessage {
  id          String           @id @default(cuid())
  userId      String           @map("user_id")
  direction   MessageDirection
  subject     String
  body        String           @db.Text
  /// Partner-side read flag (INBOUND messages in the partner inbox).
  isRead      Boolean          @default(false) @map("is_read")
  /// Admin-side read flag for partner OUTBOUND messages in the admin inbox.
  adminIsRead Boolean          @default(false) @map("admin_is_read")
  isDeleted   Boolean          @default(false) @map("is_deleted")
  createdAt   DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, direction, isDeleted])
  @@index([adminIsRead, direction, isDeleted])
  @@map("support_messages")
}

/// Post-purchase satisfaction survey — at most one per order («نظر سنجی»). The
/// positive/negative points are stored as the selected option keys (the fixed
/// option lists live in `src/lib/survey-options.ts`).
model OrderSurvey {
  id             String   @id @default(cuid())
  orderId        String   @unique @map("order_id")
  userId         String   @map("user_id")
  /// 1–5 stars.
  rating         Int
  positivePoints String[] @map("positive_points")
  negativePoints String[] @map("negative_points")
  note           String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("order_surveys")
}

/// A saved, filtered price-list request the partner can download as a printable
/// PDF («دریافت لیست قیمت»). The filter is snapshotted and the link is valid for
/// ~24h (expiresAt); after that the partner regenerates it. Empty filter arrays
/// mean "all" (all titles / brands / car models).
model PriceListRequest {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  /// Free-text product filters; fuzzy-matched against normalized name/SKU metadata. Empty = all.
  titles        String[]
  partsBrandIds Int[]    @map("parts_brand_ids")
  carModelIds   Int[]    @map("car_model_ids")
  createdAt     DateTime @default(now()) @map("created_at")
  expiresAt     DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("price_list_requests")
}

/// Wholesale partner suggestion to add a product to the shop catalogue
/// (درخواست تأمین کالا). Admins review these in the communications panel.
model ProductSuggestion {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  /// Free-text description of the product the partner wants stocked.
  body      String   @db.Text
  /// Admin-side read flag for the communications inbox.
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("product_suggestions")
}

// ─────────────────────────────────────────────────────────────────────────────
// DISCOUNT CODES / کد تخفیف
// ─────────────────────────────────────────────────────────────────────────────

/// Redeemable coupon managed in the admin panel («کد تخفیف»).
/// Checkout application is wired separately; this model stores the code rules.
model DiscountCode {
  id   String @id @default(cuid())
  /// Case-insensitive unique code the customer enters (stored uppercase).
  code String @unique

  type  DiscountType
  /// Percent (0–100) or fixed Toman amount depending on `type`. Null for FREE_SHIPPING.
  value Decimal?     @db.Decimal(12, 2)

  startsAt DateTime  @map("starts_at")
  endsAt   DateTime? @map("ends_at")

  scopeType DiscountScopeType @default(CATEGORY) @map("scope_type")
  /// Target ids for `scopeType`. Empty = applies to all products.
  scopeIds  String[]          @default([]) @map("scope_ids")

  /// Who may redeem this code: retail, wholesale, or both.
  targetUserType DiscountTargetUserType @default(BOTH) @map("target_user_type")

  /// Max redemptions per customer. Null = unlimited.
  perCustomerLimit Int? @map("per_customer_limit")
  /// Max total redemptions across all customers. Null = unlimited.
  totalUsageLimit  Int? @map("total_usage_limit")
  /// How many times this code has been successfully redeemed.
  usedCount        Int  @default(0) @map("used_count")

  /// Minimum cart subtotal (Toman) required to apply the code.
  minCartAmount     BigInt? @map("min_cart_amount")
  /// Cap on the discounted amount in Toman (mainly for PERCENTAGE).
  maxDiscountAmount BigInt? @map("max_discount_amount")
  /// When true, only customers with zero prior successful orders may use it.
  firstOrderOnly    Boolean @default(false) @map("first_order_only")
  /// Require at least this many prior completed/paid orders. Null = no requirement.
  minPreviousOrders Int?    @map("min_previous_orders")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@index([isActive])
  @@index([startsAt])
  @@index([endsAt])
  @@map("discount_codes")
}
